# Copy to .env and fill in. Do not commit .env.

# --- Server ---
# HTTPS URL Twilio and ElevenLabs can reach (ngrok, tunnel, or your host)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

# --- Database ---
# SQLite file for incidents, queue, and transcripts
DATABASE_PATH=oncall.sqlite3

# --- Runtime ---
# Repo the coding agent may change (not this on-call repo)
REPO_URL=https://github.com/your-org/your-service
# Legacy name still accepted:
# CURSOR_REPO_URL=

# --- Phone (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
MAINTAINER_NUMBER=+1...
# Optional: AMD on outbound calls from this app only
# TWILIO_MACHINE_DETECTION=Enable

# --- Voice (ElevenLabs) ---
ELEVENLABS_API_KEY=
# Agent id from Eleven Agents (agent_…), not a voice id
ELEVENLABS_AGENT_ID=
# Optional: only for API-created agents
# ELEVENLABS_VOICE_ID=

# --- Coding agent ---
# cursor | webhook
AGENT=cursor
CURSOR_API_KEY=
# When AGENT=webhook, URL of your handler (see examples/agent_webhook.py)
# AGENT_WEBHOOK_URL=http://127.0.0.1:9000/run

# --- Alerts ---
# When set, POST /alerts requires Authorization: Bearer <token>
# ALERT_TOKEN=
