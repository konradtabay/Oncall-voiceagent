# Copy to .env and fill in. Do not commit .env or put real secrets in this file.

# HTTPS URL Twilio/ElevenLabs reach (from `ngrok http 8000` or your host)
PUBLIC_BASE_URL=https://xxxx.ngrok-free.app

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
# Optional: Enable for AMD on outbound calls from this app only (unset = off)
# TWILIO_MACHINE_DETECTION=Enable
MAINTAINER_NUMBER=+1...

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional: voice for API-created agents; not used by telephony register-call
ELEVENLABS_VOICE_ID=

CURSOR_API_KEY=
CURSOR_REPO_URL=https://github.com/konradtabay/Oncall-voiceagent

DATABASE_PATH=oncall.sqlite3
